     1	import { NextResponse } from "next/server";
     2	
     3	/*
     4	 * Garde des routes de cron.
     5	 *
     6	 * Vercel Cron appelle ces routes en GET avec `Authorization: Bearer
     7	 * $CRON_SECRET`. Sans ce contrôle, n'importe qui pourrait déclencher le
     8	 * remplissage mensuel — c'est-à-dire une génération payante par utilisateur,
     9	 * autant de fois qu'il le voudrait.
    10	 *
    11	 * Sans `CRON_SECRET` en environnement, la route REFUSE tout : un secret
    12	 * manquant est une porte ouverte, pas une commodité de développement.
    13	 */
    14	export function authorizeCron(request: Request): NextResponse | null {
    15	  const secret = process.env.CRON_SECRET;
    16	
    17	  if (!secret) {
    18	    console.error("[cron] CRON_SECRET absente — appel refusé.");
    19	    return NextResponse.json({ error: "Not found." }, { status: 404 });
    20	  }
    21	
    22	  const header = request.headers.get("authorization");
    23	  if (header !== `Bearer ${secret}`) {
    24	    return NextResponse.json({ error: "Not found." }, { status: 404 });
    25	  }

