     1	import Stripe from "stripe";
     2	import { MONTHLY_PRESENCE, KIT_PLANS } from "@/lib/billing/plans";
     3	import type { KitTier } from "@/lib/kit/tiers";
     4	
     5	/*
     6	 * Client Stripe — STRICTEMENT serveur.
     7	 *
     8	 * Même convention que `lib/ai/client.ts` : aucune clé n'est écrite dans le
     9	 * repo, aucune n'est préfixée `NEXT_PUBLIC_` (sauf la publiable, qui l'est par
    10	 * nature), et ce module n'est importé que par des Server Actions et des route
    11	 * handlers. Un import depuis un composant client embarquerait `STRIPE_SECRET_KEY`
    12	 * dans le bundle du navigateur — d'où la lecture PARESSEUSE ci-dessous : rien
    13	 * n'est lu au chargement du module, donc un import fautif casse au premier
    14	 * appel plutôt que de fuiter silencieusement au build.
    15	 *
    16	 * La version d'API n'est pas épinglée à la main : le SDK envoie la sienne
    17	 * (`Stripe.apiVersion`), celle contre laquelle ses types sont générés. Épingler
    18	 * une chaîne différente ici ferait mentir les types sur ce que l'API renvoie.
    19	 */
    20	
    21	let client: Stripe | null = null;
    22	
    23	/** Levée quand une variable Stripe manque. Message serveur, jamais rendu tel quel. */
    24	export class StripeConfigError extends Error {
    25	  constructor(name: string) {
    26	    super(
    27	      `Variable d'environnement Stripe manquante : ${name}. Voir .env.example.`
    28	    );
    29	    this.name = "StripeConfigError";
    30	  }
    31	}
    32	
    33	function requireEnv(name: string): string {
    34	  const value = process.env[name];
    35	  if (!value) throw new StripeConfigError(name);
    36	  return value;
    37	}
    38	
    39	export function getStripeClient(): Stripe {
    40	  if (!client) {
    41	    client = new Stripe(requireEnv("STRIPE_SECRET_KEY"));
    42	  }
    43	  return client;
    44	}
    45	
    46	/** Secret de signature du webhook. Sans lui, aucun event n'est accepté. */
    47	export function getWebhookSecret(): string {
    48	  return requireEnv("STRIPE_WEBHOOK_SECRET");
    49	}
    50	
    51	/**
    52	 * Id du prix Stripe d'un tier de kit (`price_…`).
    53	 *
    54	 * Les ids DIFFÈRENT entre le mode test et le mode live : les figer dans le
    55	 * repo garantirait de facturer en test contre un catalogue live, ou l'inverse.
    56	 * `lib/billing/plans.ts` ne porte donc que le NOM de la variable.
    57	 */
    58	export function kitPriceId(tier: KitTier): string {
    59	  return requireEnv(KIT_PLANS[tier].priceEnvVar);
    60	}

