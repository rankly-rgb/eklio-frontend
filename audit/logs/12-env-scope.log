     1	import Anthropic from "@anthropic-ai/sdk";
     2	
     3	/*
     4	 * Client Anthropic partagé, strictement serveur. `ANTHROPIC_API_KEY` n'est
     5	 * jamais exposée au client ni préfixée `NEXT_PUBLIC_` ; le SDK la lit
     6	 * automatiquement depuis l'environnement.
     7	 *
     8	 * Aucun composant client n'importe ce module — c'est la règle qui garde la clé
     9	 * hors du bundle, et elle est vérifiée en balayant la sortie du build, pas à
    10	 * l'œil.
    11	 */
    12	let client: Anthropic | null = null;
    13	
    14	export function getAnthropicClient(): Anthropic {
    15	  if (!client) {
    16	    client = new Anthropic();
    17	  }
    18	  return client;
    19	}
    20	
    21	/** Le modèle utilisé par toutes les générations du produit. */
    22	export const GENERATION_MODEL = "claude-opus-5";

