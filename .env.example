# Supabase — Project Settings > API (dashboard.supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — never exposed to the client, never used outside server code.
# Used by the Stripe webhook, which has no user session and must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute base URL. Used for the email confirmation link and for Stripe's
# success and cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic — server-side generation only, never NEXT_PUBLIC_
ANTHROPIC_API_KEY=

# Stripe — server-side only. We use Stripe's hosted Checkout, so no card data
# reaches this app and no publishable key is needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price ids. Prices live in the Stripe dashboard so test and live mode
# can differ without a deploy. See lib/billing/plans.ts for the amounts.
STRIPE_PRICE_STARTER=            # one-time, $79
STRIPE_PRICE_PRACTICE=           # one-time, $149
STRIPE_PRICE_SIGNATURE=          # one-time, $249
STRIPE_PRICE_MONTHLY_PRESENCE=   # recurring, $39/month
