# Supabase — projet US `eklio-backend-us` (ref fobgdsupyfslxbswfuay, us-east-1).
# Le schéma vit dans le repo eklio-backend : ce repo ne fait que le consommer.
# Clés : Project Settings > API (dashboard.supabase.com).
#
# ATTENTION : depuis le Lot 4, le front consomme les tables de facturation
# (`subscriptions`, `purchases`, `stripe_events`, `monthly_presence_content`,
# `brand_kits.tier`, `profiles.stripe_customer_id`) qui n'existent QUE sur l'US.
# Un `.env.local` resté pointé sur l'ancienne base EU fait échouer tout le lot.
NEXT_PUBLIC_SUPABASE_URL=https://fobgdsupyfslxbswfuay.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrète — jamais exposée au client, jamais utilisée hors route handlers serveur.
# Le webhook Stripe en a un besoin STRUCTUREL : `stripe_events`, `purchases`,
# `subscriptions` et `monthly_presence_content` sont en écriture service_role
# uniquement (RLS : lecture propriétaire, écriture refusée aux clients).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du déploiement, base du lien de confirmation d'email
# (lib/actions/auth.ts) et des URL de retour de Stripe Checkout
# (lib/stripe/checkout.ts). Sans elle, repli sur http://localhost:3000 — les
# emails de confirmation et les retours de paiement renverraient alors vers
# localhost en preview/prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Appels IA côté serveur uniquement, jamais NEXT_PUBLIC_
ANTHROPIC_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────
# Clé secrète serveur (sk_test_… en test, sk_live_… en prod). Lue par
# lib/stripe/client.ts, jamais exposée au navigateur.
STRIPE_SECRET_KEY=

# Secret de signature du webhook (whsec_…), donné par `stripe listen` en local
# et par le dashboard en prod. Sans lui, la route webhook refuse TOUT event :
# c'est la seule preuve qu'un paiement vient bien de Stripe.
STRIPE_WEBHOOK_SECRET=

# Clé publiable — publique par nature, mais elle reste une valeur d'env pour
# que test et prod ne se mélangent pas dans le repo.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Identifiants de prix Stripe (price_…), un par tier + l'add-on mensuel.
# Créés dans le dashboard Stripe (Products), en mode test PUIS en mode live :
# les ids diffèrent entre les deux modes. Les montants affichés par /pricing
# viennent de lib/billing/plans.ts ; ces variables ne portent QUE les ids.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRACTICE=
STRIPE_PRICE_SIGNATURE=
STRIPE_PRICE_MONTHLY_PRESENCE=
