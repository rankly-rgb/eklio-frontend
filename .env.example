# Supabase — Project Settings > API (dashboard.supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrète — jamais exposée au client, jamais utilisée hors route handlers serveur.
# Sert au webhook Stripe (grant_plan_allowance est service_role only) et à rien d'autre.
SUPABASE_SERVICE_ROLE_KEY=

# Génération des directions et Ethics Guard. Serveur uniquement.
ANTHROPIC_API_KEY=

# Stripe — Developers > API keys, puis Developers > Webhooks pour le secret.
# Aucun produit ni prix à créer dans Stripe : les montants viennent de la table
# `plans`, seule source de vérité de ce qu'un palier vaut et de ce qu'il donne.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Utilisée pour construire les URL de retour de Stripe quand l'en-tête Origin
# est absent (webhooks, appels serveur à serveur).
NEXT_PUBLIC_SITE_URL=https://eklio.com
